# Gerçek telefon (Mac ile aynı Wi-Fi ağında):
API_BASE_URL=http://192.168.1.x:4000/api

# Android emulator (10.0.2.2 = emulator'ü çalıştıran bilgisayar, hiç değişmez):
# API_BASE_URL=http://10.0.2.2:4000/api

# Mac masaüstü uygulaması / iOS simulator:
# API_BASE_URL=http://localhost:4000/api

# RevenueCat (abonelik/satın alma) — Dashboard > Project Settings > API Keys
# altındaki "Google Play" public app-specific anahtarı. Boş bırakılırsa
# RevenueCat sessizce devre dışı kalır (boot çökmez, satın alma denemesi
# "şu anda kullanılamıyor" hatası verir) — plan §Faz 5.
REVENUECAT_API_KEY=
