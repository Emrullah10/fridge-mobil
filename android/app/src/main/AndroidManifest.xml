<manifest 
    xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 13+ (API 33) push bildirimi göstermek için runtime izin
         gerektiriyor — bu sadece manifest deklarasyonu, kullanıcıya soru
         main.dart'taki FirebaseMessaging.requestPermission() ile sorulur. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Sesli ürün girişi (speech_to_text) — runtime izni paket kendisi ister. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- CAMERA izni tek başına kamerayı zorunlu cihaz özelliği yapıyor;
         galeriden fiş seçmek de mümkün olduğu için kamerasız cihazlar
         (Chromebook vb.) Play'de uygulamayı görebilsin diye required=false. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <application
        android:label="Fridge"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Davet linki: https://api-fridge.emrullahbozkurt.com/join/KOD.
                 autoVerify, Android'e /.well-known/assetlinks.json üzerinden
                 domain sahipliğini doğrulamasını söyler — doğrulama
                 başarısız olursa link tarayıcıda açılır (uygulama açılmaz),
                 bu yüzden assetlinks.json'ın canlıda erişilebilir olması
                 şart (bkz. backend join sayfası). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="api-fridge.emrullahbozkurt.com"
                    android:pathPrefix="/join"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
